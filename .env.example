# Copy this file to .env and replace every stub below.
# BuildDMG.sh sources .env as shell syntax. Keep values quoted.
# The certificate and its private key must already be in an unlocked keychain.
# Find the exact certificate name with: security find-identity -v -p codesigning
CODE_SIGN_IDENTITY='Developer ID Application: YOUR_NAME (YOUR_TEAM_ID)'
APPLE_TEAM_ID='YOUR_TEAM_ID'
APPLE_ID='your-apple-id@example.com'

# Generate an app-specific password at https://account.apple.com/.
# This is not your normal Apple Account password.
APPLE_APP_SPECIFIC_PASSWORD='xxxx-xxxx-xxxx-xxxx'

# Optional: absolute path, or a path relative to this project directory.
DIX_BUILD_DIR='build'

# Maximum wait for Apple's response; a timeout does not cancel the submission.
NOTARY_TIMEOUT='30m'
